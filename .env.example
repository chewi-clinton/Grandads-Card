# Set these in Dokploy's "Environment Variables" panel for the MinIO app.
# MinIO is deployed standalone (this compose file only), separate from the
# backend and frontend, which each deploy independently via their own Dockerfile.

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET_NAME=grandadscards
MINIO_API_PORT=13012
MINIO_CONSOLE_PORT=13013
